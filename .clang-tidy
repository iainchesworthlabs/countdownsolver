---
# Static analysis for first-party code. Kept in step with the compiler warning
# set in cmake/CompilerWarnings.cmake.
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay

WarningsAsErrors: ''
HeaderFilterRegex: 'src/(lib|app)/.*'
FormatStyle: file

CheckOptions:
  # Naming: the conventions the code follows, measured in October 2026 (D9 keeps
  # an established repository's own). Types are CamelCase; functions, methods,
  # locals, parameters, namespaces and struct fields are lower_case; private and
  # protected members end in an underscore; constants at namespace or class scope
  # are kCamelCase and local constants are lower_case; macros are UPPER_CASE. The
  # Qt-facing code under src/app is camelCase (src/app/.clang-tidy).
  # Enumerators are lower_case in the library (src/lib) and kCamelCase in the one
  # enum of the app, so the check accepts both and a new enum follows its neighbours.
  # The version and git constants of the generated version.hpp are lower_case, and
  # max_v and min_v are variable templates named like the standard library's _v ones.
  # Renaming them is a separate change (docs/migration.md).
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^(version_(major|minor|patch|string)|git_[a-z_]+|(max|min)_v)$'
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.EnumConstantCase: aNy_CasE
